/* ---------- 首页 ---------- */
.brand { text-align: center; padding: 10rpx 0 4rpx; }
.brand-title {
  font-size: 64rpx; letter-spacing: 4rpx; font-weight: 900;
  background: linear-gradient(92deg, #3ea6ff, #a98bff 55%, #ff8f7a);
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.brand-sub { margin-top: 10rpx; color: #71809e; font-size: 26rpx; letter-spacing: 1rpx; }

/* 气泡 */
.bubble-row { text-align: center; margin: 14rpx 0 6rpx; }
.bubble {
  display: inline-block; background: #fff; border: 3rpx solid #e6ecf8;
  border-radius: 30rpx; padding: 14rpx 30rpx; font-size: 27rpx; color: #2b3a55;
  box-shadow: 0 8rpx 20rpx rgba(96, 124, 178, .1);
  max-width: 620rpx;
}

/* ---------- 世界舞台 ---------- */
/* .world / .world-bg / .world-mascot / .panda-layer / .world-tag / .world-hint / .snowfall / .flake
   已上移到 app.wxss（全局），供首页和结果页共用 */

/* ---------- 养成进度 ---------- */
.pp { margin: 24rpx 6rpx 0; }
.pp-text { margin-top: 10rpx; font-size: 26rpx; color: #2b3a55; }
.pp-text .b { font-weight: 800; }
.chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.chip2 {
  font-size: 30rpx; line-height: 1; padding: 8rpx; border-radius: 12rpx;
  opacity: .22; filter: grayscale(1); background: #fff;
}
.chip2.on { opacity: 1; filter: none; }
.pp-world { margin-top: 12rpx; font-size: 24rpx; color: #71809e; }

/* ---------- 小朋友 ---------- */
.link { font-size: 26rpx; font-weight: 800; color: #2f8fd6; padding: 6rpx 4rpx; }
.players { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 20rpx; }
.player {
  display: flex; flex-direction: column; align-items: center;
  min-width: 132rpx; padding: 16rpx 22rpx;
  background: #f7fafd; border: 3rpx solid #e6ecf8; border-radius: 24rpx;
}
.player.on { background: #eaf6ff; border-color: #5cb8ff; box-shadow: 0 8rpx 20rpx rgba(92, 184, 255, .18); }
.player .pn { font-size: 30rpx; font-weight: 900; color: #2b3a55; }
.player .pa { font-size: 21rpx; color: #71809e; margin-top: 2rpx; }
.player.on .pa { color: #2f8fd6; }
.btn.danger {
  color: #e05b5b; border-color: #ffd7d7; box-shadow: 0 6rpx 0 #ffe6e6;
  background: #fff8f8;
}

/* ---------- 表单 ---------- */
.field { margin-top: 22rpx; }
.field:first-child { margin-top: 0; }
.label { font-size: 26rpx; font-weight: 800; color: #2b3a55; margin-bottom: 12rpx; }
.inp {
  background: #f4f8ff; border: 3rpx solid #e6ecf8; border-radius: 20rpx;
  padding: 18rpx 24rpx; font-size: 30rpx; color: #2b3a55;
}

/* ---------- 玩法选择 ---------- */
.modes { display: flex; flex-wrap: wrap; gap: 16rpx; }
.mode {
  width: calc(50% - 8rpx); background: #f7fafd; border: 3rpx solid #e6ecf8;
  border-radius: 24rpx; padding: 20rpx; transition: all .15s ease;
}
.mode.wide { width: 100%; }
.mode.on { border-color: #5cb8ff; background: #eaf6ff; box-shadow: 0 8rpx 20rpx rgba(92, 184, 255, .18); }
.mt { font-size: 30rpx; font-weight: 900; color: #2b3a55; }
.tagline {
  font-size: 20rpx; color: #fff; background: #ff8f7a; border-radius: 999rpx;
  padding: 4rpx 12rpx; margin-left: 8rpx; vertical-align: 4rpx; font-weight: 700;
}
.md { margin-top: 8rpx; font-size: 23rpx; color: #71809e; line-height: 1.6; }

.foot-note { margin-top: 24rpx; }

/* ---------- 名字 + 年龄 同一行 ---------- */
.formrow { gap: 16rpx; align-items: stretch; }
.col-name { flex: 2; min-width: 0; }
.col-age { flex: 1; min-width: 0; }
/* picker 组件和输入框都要显式撑满列宽，否则会被 flex 挤没 */
.formrow .inp,
.formrow picker,
.formrow picker .inp { width: 100%; box-sizing: border-box; display: block; }
/* 原生 input 和普通 view 的默认行高不一致 → 统一固定高度 */
.formrow .inp { height: 84rpx; line-height: 84rpx; padding: 0 24rpx; overflow: hidden; }

/* ---------- 夏天的海边：冲浪效果 ---------- */
/* 波浪层：两道半透明长条错向滚动，叠在背景的海面上 */
.surf-layer { position: absolute; left: 0; right: 0; bottom: 4%; height: 20%; overflow: hidden; pointer-events: none; }
.wave {
  position: absolute; bottom: 0; left: -110%; width: 320%; height: 100%;
  border-radius: 46% 54% 0 0 / 90% 75% 0 0;
  background: rgba(92, 184, 255, .26);
  animation: waveRoll 6.5s linear infinite;
}
.wave.b { bottom: 6%; background: rgba(255, 255, 255, .38); animation-duration: 8.6s; animation-direction: reverse; opacity: .7; }
@keyframes waveRoll { from { transform: translateX(0); } to { transform: translateX(31%); } }

/* 豆豆冲浪：入场从左侧滑进来，然后随浪起伏 */
.surf-wrap { width: 100%; height: 100%; }
.surf-wrap.on { animation: surfIn 1.2s cubic-bezier(.2, .8, .3, 1) both, surfBob 2.6s ease-in-out 1.2s infinite; }
@keyframes surfIn {
  from { transform: translateX(-130%) rotate(-8deg); }
  75%  { transform: translateX(6%) rotate(3deg); }
  to   { transform: translateX(0) rotate(0); }
}
@keyframes surfBob {
  0%, 100% { transform: translateY(0) rotate(-2.5deg); }
  50%      { transform: translateY(-16rpx) rotate(3deg); }
}

/* 水花：豆豆脚边几颗小白点循环迸溅 */
.drop {
  position: absolute; width: 12rpx; height: 12rpx; border-radius: 50%;
  background: rgba(255, 255, 255, .85); opacity: 0;
}
.drop.d1 { left: 40%; bottom: 30%; animation: dropPop 2s .3s ease-out infinite; }
.drop.d2 { left: 48%; bottom: 24%; animation: dropPop 2s 1.1s ease-out infinite; }
.drop.d3 { left: 56%; bottom: 32%; animation: dropPop 2s 1.7s ease-out infinite; }
@keyframes dropPop {
  0%   { transform: translate(0, 0) scale(.4); opacity: 0; }
  25%  { opacity: .95; }
  100% { transform: translate(24rpx, -44rpx) scale(1); opacity: 0; }
}
