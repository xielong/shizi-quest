/* ---------- 测试页 ---------- */
.topbar { display: flex; align-items: center; gap: 14rpx; }
.tchip {
  background: #fff; border-radius: 999rpx; padding: 10rpx 24rpx;
  font-size: 26rpx; font-weight: 800; color: #2b3a55;
  box-shadow: 0 6rpx 16rpx rgba(96, 124, 178, .1);
}
.tchip.star { color: #e8a900; }

.prog { margin-top: 20rpx; height: 16rpx; }
.lvrow { display: flex; justify-content: space-between; margin: 14rpx 6rpx 0; font-size: 25rpx; }
.lvtext { color: #2b3a55; font-weight: 700; }

.stage { margin-top: 22rpx; min-height: 560rpx; display: flex; flex-direction: column; }
.prompt { text-align: center; color: #71809e; font-size: 27rpx; }
.fbrow { min-height: 90rpx; display: flex; justify-content: center; align-items: center; }
.fb {
  border-radius: 999rpx; padding: 12rpx 34rpx; font-size: 30rpx; font-weight: 800;
  animation: popIn .25s ease both;
}
.fb.ok { background: #e7f9f1; color: #25b981; }
.fb.no { background: #fff1ea; color: #f07b4e; }
.fb.info { background: #eaf4ff; color: #3ea6ff; }

/* 大字 */
.glyphwrap { flex: 1; display: flex; align-items: center; justify-content: center; padding: 30rpx 0; }
.glyph {
  font-size: 220rpx; font-weight: 900; color: #2b3a55; line-height: 1.15;
  animation: popIn .28s cubic-bezier(.3, 1.4, .5, 1) both;
}

/* 四选一 */
.optgrid { flex: 1; display: flex; flex-wrap: wrap; gap: 22rpx; padding: 34rpx 6rpx; align-content: center; }
.opt {
  width: calc(50% - 11rpx); height: 150rpx;
  display: flex; align-items: center; justify-content: center;
  background: #f7fafd; border: 3rpx solid #e6ecf8; border-radius: 26rpx;
  font-size: 84rpx; font-weight: 800; color: #2b3a55;
}
.opt.right { background: #e7f9f1; border-color: #25b981; color: #25b981; animation: popIn .2s ease both; }
.opt.wrong { background: #fff1ea; border-color: #ff9a76; color: #f07b4e; }
.listen-note { text-align: center; color: #a98bff; font-size: 24rpx; padding-bottom: 16rpx; font-weight: 700; }

/* 句子 */
.sent { flex: 1; display: flex; flex-wrap: wrap; justify-content: center; padding: 36rpx 4rpx; align-content: center; }
.c {
  font-size: 62rpx; font-weight: 800; color: #2b3a55; line-height: 1.7;
  padding: 0 4rpx;
}
.c.punc { color: #71809e; }
.c.unk {
  color: #fff; background: #ff9a76; border-radius: 14rpx;
  animation: unkpop .3s cubic-bezier(.3, 1.6, .5, 1) both;
}
@keyframes unkpop { from { transform: scale(1.4); } to { transform: scale(1); } }

/* 判分按钮 */
.parentbar { display: flex; gap: 22rpx; margin-top: 26rpx; }
.judge {
  flex: 1; border-radius: 999rpx; padding: 30rpx 0; font-size: 36rpx; font-weight: 900;
  color: #fff; border: 0; line-height: 1.2;
}
.judge::after { border: 0; }
.judge.yes { background: linear-gradient(180deg, #4fdc9f, #25b981); box-shadow: 0 10rpx 0 #1d9968, 0 18rpx 30rpx rgba(37, 185, 129, .28); }
.judge.no { background: linear-gradient(180deg, #ffb08c, #ff8a5e); box-shadow: 0 10rpx 0 #e06f42, 0 18rpx 30rpx rgba(255, 138, 94, .28); }
.judge:active { transform: translateY(6rpx); box-shadow: 0 4rpx 0 rgba(0, 0, 0, .15); }

.sentbar { display: flex; gap: 18rpx; margin-top: 26rpx; }

.mini { margin-top: 24rpx; text-align: center; color: #71809e; font-size: 24rpx; line-height: 1.7; }

/* 右下角小豆豆 */
.mini-panda {
  position: fixed; right: 20rpx; bottom: calc(30rpx + env(safe-area-inset-bottom));
  width: 150rpx; height: 200rpx; z-index: 30;
  animation: bob 2.6s ease-in-out infinite;
}
.mini-panda .panda-layer { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }

/* 新零件喜报 */
.panda-toast {
  position: fixed; left: 50%; bottom: 320rpx; transform: translateX(-50%);
  background: rgba(43, 58, 85, .92); color: #fff; border-radius: 28rpx;
  padding: 22rpx 36rpx; text-align: center; z-index: 60;
  box-shadow: 0 16rpx 40rpx rgba(43, 58, 85, .3);
  animation: toastIn .4s cubic-bezier(.3, 1.5, .5, 1) both;
  max-width: 560rpx;
}
.pt-e { font-size: 60rpx; line-height: 1.3; }
.pt-tip { font-size: 26rpx; margin-top: 6rpx; }
@keyframes toastIn { from { opacity: 0; transform: translate(-50%, 30rpx) scale(.8); } to { opacity: 1; transform: translate(-50%, 0) scale(1); } }

/* 全屏雪 */
.snowfull { position: fixed; left: 0; top: 0; right: 0; bottom: 0; pointer-events: none; z-index: 50; overflow: hidden; }
